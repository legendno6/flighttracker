# Copy this file to .env and fill in your values.
# Read only by the server-side proxies (server/flightAwareCore.ts,
# server/openSkyCore.ts) — never sent to or bundled into the browser, unlike
# AviationStack's key, which lives in the app's Settings UI instead.

FLIGHTAWARE_API_KEY=

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Only used by server/productionServer.ts (the Pi/self-hosted server), and
# only if you want browser notifications to work — see the "Enabling
# notifications (HTTPS)" section in README.md. Leave unset to use the
# defaults (deploy/certs/cert.pem, deploy/certs/key.pem, port 3443).
# TLS_CERT_PATH=
# TLS_KEY_PATH=
# TLS_PORT=
